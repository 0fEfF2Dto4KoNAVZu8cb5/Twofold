IMMICH_URL=https://photos.example.com
# An existing album UUID. If blank, the worker creates one named below once.
IMMICH_ALBUM_ID=
IMMICH_ALBUM_NAME=Twofold

# Explicit same-NAS/private numeric-address HTTP opt-in; HTTPS is the default.
IMMICH_ALLOW_LOCAL_HTTP=false

# Optional HTTPS origin of your self-hosted ntfy server, without a topic/path.
# Leave empty to keep direct/periodic delivery only.
NTFY_URL=
